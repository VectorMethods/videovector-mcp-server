{
  "schema_version": "1.0.0",
  "package": {
    "registry": "npm",
    "name": "@vectormethods/videovector-mcp-server",
    "tarball_command": "npm pack --dry-run"
  },
  "mcp_registry": {
    "registry": "https://registry.modelcontextprotocol.io",
    "name": "io.github.VectorMethods/videovector-mcp-server",
    "metadata_path": "server.json"
  },
  "release_inputs": [
    "src/**",
    "ui/**",
    "scripts/build-picker.mjs",
    "scripts/clean-dist.mjs",
    "scripts/generate-contract.mjs",
    "package.json",
    "package-lock.json",
    "server.json",
    "tsconfig.json",
    "README.md",
    "docs/**",
    "examples/**",
    "artifacts/tool-contract.json",
    "artifacts/app-tool-contract.json"
  ]
}
